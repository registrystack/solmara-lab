meta {
  name: 08 - NAgDI livestock lookup
  type: http
  seq: 8
}

post {
  url: {{nagdi_relay_url}}/v2/resources/livestock-herd/lookups/movement-by-farmer-id?fields=registeredHerd,herdVaccinationCurrent,originDistrictNotQuarantinedForSpecies,destinationDistrictOpen,noConflictingOpenMovementPermit
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{NAGDI_LIVESTOCK_RELAY_TOKEN}}
  Accept: application/json
}

body:json {
  {"selectors":{"farmerId":"FR-000002"}}
}

meta {
  name: 02 - Livestock movement control
  type: http
  seq: 2
}

post {
  url: {{evidence_url}}/v1/evidence
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{SOLMARA_EVIDENCE_ACCESS_TOKEN}}
  Content-Type: application/json
  Accept: application/jose+json
}

body:json {
  {
    "requestNonce": "{{request_nonce}}",
    "requirement": "https://id.registrystack.org/solmara/requirement/nagdi-livestock/v1",
    "purpose": "livestock-movement-control",
    "subjects": [{
      "role": "subject",
      "selector": {
        "profile": "farmer-reference-v1",
        "values": { "farmer_id": "FR-1001" }
      }
    }]
  }
}

script:pre-request {
  const crypto = require("crypto");
  bru.setVar("request_nonce", crypto.randomBytes(32).toString("base64url"));
}

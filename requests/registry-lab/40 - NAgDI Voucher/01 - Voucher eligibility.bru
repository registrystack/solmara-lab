meta {
  name: 01 - Voucher eligibility
  type: http
  seq: 1
}

post {
  url: {{nagdi_evidence_url}}/v1/evidence
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{EVIDENCE_ACCESS_TOKEN}}
  Accept: application/jose+json
}

body:json {
  {
    "requestNonce": "DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD",
    "requirement": "https://id.registrystack.org/solmara/requirement/nagdi-voucher/v1",
    "purpose": "voucher-eligibility-review",
    "subjects": [{
      "role": "subject",
      "selector": {
        "profile": "farmer-reference-v1",
        "values": {"farmer_id": "FR-1001"}
      }
    }]
  }
}

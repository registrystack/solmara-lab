meta {
  name: 01 - Request CRA child benefit evidence
  type: http
  seq: 1
}

post {
  url: {{evidence_url}}/v1/evidence
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{SOLMARA_EVIDENCE_ACCESS_TOKEN}}
  Content-Type: application/json
  Accept: application/jose+json
}

body:json {
  {
    "requestNonce": "{{request_nonce}}",
    "requirement": "https://id.registrystack.org/solmara/requirement/cra-child-benefit/v1",
    "purpose": "child-benefit-review",
    "subjects": [{
      "role": "subject",
      "selector": {
        "profile": "solmara-uin-v1",
        "values": { "uin": "2300010248" }
      }
    }]
  }
}

script:pre-request {
  const crypto = require("crypto");
  bru.setVar("request_nonce", crypto.randomBytes(32).toString("base64url"));
}
